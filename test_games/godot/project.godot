; Original UGA test fixture. Godot 4.x, no external assets or plugins.
config_version=5

[application]
config/name="UGA Test Arena"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=160
window/size/viewport_height=112
window/size/window_width_override=640
window/size/window_height_override=448
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.070588, 0.086275, 0.137255, 1)
